# Copia este archivo como .env en la raíz del proyecto y completa los valores.
# El archivo .env nunca se sube al repositorio.

# --- API (FastAPI) ---
# Clave larga y aleatoria para firmar los tokens. Genera una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Base de datos ---
# Para desarrollo local basta SQLite. Si se define SQL_SERVER, se usa SQL Server.
DATABASE_URL=sqlite:///invision.db

# --- SQL Server (producción, opcional en local) ---
SQL_SERVER=
SQL_DATABASE=
SQL_USERNAME=
SQL_PASSWORD=
SQL_DRIVER={ODBC Driver 18 for SQL Server}

# --- Azure Blob Storage (audio) ---
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER_NAME=audiolibros

# --- Panel operativo (admin-dashboard) ---
ADMIN_TOKEN=
